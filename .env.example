# CASE 后端配置示例 —— 复制为 .env 后填写。
# .env 已被 gitignore，切勿把真实密钥提交进仓库。

# ── DeepSeek API ─────────────────────────────────────
# 留空则 AI 助手优雅降级：病案问答仅返回检索结果，写作辅助不可用，
# 其余功能（录入/检索/本地 OCR/导出）完全不受影响。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── LLM 端点注册表（自托管预留，见 docs/llm-integration.md）──
# 当前默认单端点 deepseek-api；自托管落地时改为逗号分隔多端点，
# 并补上 LLM_<NAME>_* 各字段。
# LLM_ENDPOINTS=deepseek-api
